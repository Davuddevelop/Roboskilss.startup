# ---- Roboskills environment ----
# Copy to `.env.local` for local development. Never commit real secrets.

# Public site URL (used for metadata / OG). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Supabase (Phase 2+) ----
# From your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Feature flags ----
# When false (default), training jobs resolve to seeded demo data so the
# product is fully clickable without a live RL worker. Flip to true to enqueue
# real jobs for the Python engine to pick up.
NEXT_PUBLIC_LIVE_TRAINING=false

# ---- Stripe (Phase 5, stubbed in MVP) ----
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
